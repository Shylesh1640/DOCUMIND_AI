# ───────────────────────────────────────────
#  DocuMind AI — Environment Variables
# ───────────────────────────────────────────

# Groq — primary LLM provider (fast LLaMA models)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# OpenRouter — alternative LLM provider (100+ models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# LLM Provider selection: "groq" (default) or "openrouter"
LLM_PROVIDER=groq

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter model to use (default: meta-llama/llama-3.1-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct:free

# ChromaDB — vector database
# Local: http://localhost:8000
# Hosted (Railway/Render/Fly.io): https://your-chroma-instance.railway.app
CHROMA_URL=http://localhost:8000

# ChromaDB collection names (optional — defaults shown)
CHROMA_CHUNKS_COLLECTION=documind_chunks
CHROMA_DOCS_COLLECTION=documind_docs

# App URL (used for OpenRouter referrer header)
NEXT_PUBLIC_APP_URL=http://localhost:3000
